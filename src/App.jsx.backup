function loadData() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
  } catch {}
  return { petData: INITIAL_PET_DATA, sightings: INITIAL_SIGHTINGS, areas: INITIAL_AREAS };
}
function saveData(d) {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(d)); } catch {}
}

// ─── Custom Leaflet marker ────────────────────────────────────────────────────
function sightingIcon(num, isLatest) {
  const bg = isLatest ? '#f97316' : '#475569';
  return L.divIcon({
    className: '',
    html: `<div style="width:30px;height:30px;background:${bg};border:3px solid white;border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 2px 8px rgba(0,0,0,.3);display:flex;align-items:center;justify-content:center"><span style="transform:rotate(45deg);font-size:11px;font-weight:900;color:white;line-height:1;font-family:system-ui">${num}</span></div>`,
    iconSize: [30, 30], iconAnchor: [15, 30], popupAnchor: [0, -32],
  });
}

// Status colors: 未着手=slate, 捜索中=blue, 確認済み=green, 発見=amber
const AREA_STATUS_STYLE = {
  '未着手':  { bg: '#94A3B8', symbol: '–',  badge: 'bg-slate-100 text-slate-500' },
  '捜索中':  { bg: '#3B82F6', symbol: '▶', badge: 'bg-blue-100  text-blue-600'  },
  '確認済み': { bg: '#22C55E', symbol: '✓',  badge: 'bg-green-100 text-green-600' },
  '発見':    { bg: '#F59E0B', symbol: '★',  badge: 'bg-amber-100 text-amber-600' },
};
function areaIcon(status) {
  const { bg, symbol } = AREA_STATUS_STYLE[status] || AREA_STATUS_STYLE['未着手'];
  return L.divIcon({
    className: '',
    html: `<div style="width:28px;height:28px;background:${bg};border:3px solid white;border-radius:7px;box-shadow:0 2px 8px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:900;color:white;font-family:system-ui;line-height:1">${symbol}</div>`,
    iconSize: [28, 28], iconAnchor: [14, 14], popupAnchor: [0, -16],
  });
}

// Auto-fit map viewport to show all given lat/lng points
function FitBoundsToMarkers({ points }) {
  const map = useMap();
  useEffect(() => {
    if (!points.length) return;
    const bounds = L.latLngBounds(points.map(p => [p.lat, p.lng]));
    if (bounds.isValid()) map.fitBounds(bounds, { padding: [36, 36], maxZoom: 15 });
  }, [points.length]); // re-fit when point count changes
  return null;
}

function MapClickHandler({ onMapClick }) {
  useMapEvents({ click: (e) => onMapClick(e.latlng) });
  return null;
}

